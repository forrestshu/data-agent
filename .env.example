# DeepSeek 只允许在后端读取，切勿放进 VITE_* 前端变量。
DEEPSEEK_API_KEY=replace-with-a-rotated-key
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_TIMEOUT_SECONDS=45
DATA_AGENT_DEFAULT_SOURCE=sqlserver_company
DATA_AGENT_SQLSERVER_HOST=
DATA_AGENT_SQLSERVER_PORT=1433
DATA_AGENT_SQLSERVER_DATABASE=prod
DATA_AGENT_SQLSERVER_SCHEMA=Cux
DATA_AGENT_SQLSERVER_USERNAME=
DATA_AGENT_SQLSERVER_PASSWORD=
DATA_AGENT_SQLSERVER_ENCRYPT=true
DATA_AGENT_SQLSERVER_TRUST_SERVER_CERTIFICATE=true
DATA_AGENT_SQLSERVER_LOGIN_TIMEOUT_SECONDS=8
DATA_AGENT_SQLSERVER_QUERY_TIMEOUT_SECONDS=8
DATA_AGENT_SQLSERVER_EXPORT_TIMEOUT_SECONDS=60
DATA_AGENT_SQLSERVER_STATISTICS_TIMEOUT_SECONDS=30
DATA_AGENT_SQLSERVER_STATISTICS_WORKERS=2
DATA_AGENT_SQLSERVER_STATISTICS_RETRY_COOLDOWN_SECONDS=3600
