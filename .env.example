# DeepSeek 只允许在后端读取，切勿放进 VITE_* 前端变量。
DEEPSEEK_API_KEY=replace-with-a-rotated-key
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_TIMEOUT_SECONDS=45

# 默认使用 SQL Server；前端可切换到 SQLite 本地快照。
DATA_AGENT_DEFAULT_SOURCE=sqlserver
SQLSERVER_HOST=192.168.1.107
SQLSERVER_PORT=1433
SQLSERVER_USER=dataagent
SQLSERVER_PASSWORD=replace-with-sqlserver-password
SQLSERVER_DATABASE=prod
SQLSERVER_SCHEMA=Cux
